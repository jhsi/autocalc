{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "tests"],
  "exclude": [
    "src/figma/adapter.ts",
    "src/figma/code.ts",
    "src/figma/text.ts",
    "src/figma/highlight.ts",
    "src/figma/nearest-text.ts",
    "src/figma/badges.ts"
  ]
}
