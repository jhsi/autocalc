{
  "name": "cell-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless spreadsheet-style computation engine. Figma is not a dependency.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
